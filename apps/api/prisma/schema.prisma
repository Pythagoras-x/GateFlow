generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("STANDARD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites     Site[]
  users     User[]
  employees Employee[]
  visitors  Visitor[]

  @@map("tenants")
}

model Site {
  id           String   @id @default(uuid())
  tenantId     String?
  name         String
  siteIdHash   String   @unique
  timezone     String   @default("UTC")
  latitude     Float?
  longitude    Float?
  radiusMeters Float?   @default(100.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?            @relation(fields: [tenantId], references: [id])
  events       AttendanceEvent[]
  anchors      Anchor[]
  passes       VisitorPass[]
  gateLogs     GateLog[]

  @@map("sites")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  emailEnc     String   @unique
  role         String   @default("Security") // Admin, HR, Security, Host, Auditor
  passwordHash String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id])

  @@map("users")
}

model Shift {
  id           String     @id @default(uuid())
  name         String
  startTime    String     @default("09:00")
  endTime      String     @default("17:00")
  graceMinutes Int        @default(15)

  employees    Employee[]

  @@map("shifts")
}

model Employee {
  id         String   @id @default(uuid())
  tenantId   String?
  employeeNo String   @unique
  nameEnc    String
  phoneEnc   String?
  department String
  shiftId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant?           @relation(fields: [tenantId], references: [id])
  shift      Shift?            @relation(fields: [shiftId], references: [id])
  devices    Device[]
  events     AttendanceEvent[]

  @@map("employees")
}

model Device {
  id         String   @id @default(uuid())
  employeeId String
  publicKey  String
  platform   String   @default("web")
  boundAt    DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model AttendanceEvent {
  id          String   @id @default(uuid())
  employeeId  String
  siteId      String
  type        String   // IN, OUT
  occurredAt  DateTime @default(now())
  method      String   @default("QR") // QR, NFC, BLE, KIOSK, MANUAL
  leafHash    String   @unique
  saltEnc     String
  nonce       String
  anchorId    String?

  employee    Employee @relation(fields: [employeeId], references: [id])
  site        Site     @relation(fields: [siteId], references: [id])
  anchor      Anchor?  @relation(fields: [anchorId], references: [id])
  proof       MerkleProof?
  corrections Correction[]

  @@index([siteId, occurredAt])
  @@map("attendance_events")
}

model Anchor {
  id          String   @id @default(uuid())
  siteId      String
  period      BigInt
  merkleRoot  String
  txHash      String?
  ledger      Int?
  status      String   @default("PENDING") // PENDING, CONFIRMED, FAILED
  createdAt   DateTime @default(now())
  confirmedAt DateTime?

  site        Site              @relation(fields: [siteId], references: [id])
  events      AttendanceEvent[]

  @@unique([siteId, period])
  @@map("anchors")
}

model MerkleProof {
  id        String   @id @default(uuid())
  eventId   String   @unique
  proofJson String
  createdAt DateTime @default(now())

  event     AttendanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("merkle_proofs")
}

model Correction {
  id            String   @id @default(uuid())
  eventId       String
  reason        String
  requestedBy   String
  approvedBy    String
  onchainTxHash String?
  createdAt     DateTime @default(now())

  event         AttendanceEvent @relation(fields: [eventId], references: [id])

  @@map("corrections")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  entity    String
  payload   String   // JSON string
  prevHash  String?
  entryHash String
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Visitor {
  id         String   @id @default(uuid())
  tenantId   String?
  nameEnc    String
  emailEnc   String
  phoneEnc   String?
  companyEnc String?
  purpose    String
  hostId     String
  status     String   @default("PRE_REGISTERED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant?       @relation(fields: [tenantId], references: [id])
  passes     VisitorPass[]

  @@map("visitors")
}

model VisitorPass {
  id            String   @id @default(uuid())
  visitorId     String
  hostId        String
  siteId        String
  passIdHash    String   @unique
  passHash      String
  validFrom     DateTime
  validUntil    DateTime
  status        String   @default("ISSUED") // ISSUED, ENTERED, EXITED, REVOKED, EXPIRED
  onchainTxHash String?
  qrToken       String?
  entryTime     DateTime?
  exitTime      DateTime?
  createdAt     DateTime @default(now())

  visitor       Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  site          Site      @relation(fields: [siteId], references: [id])
  logs          GateLog[]

  @@map("visitor_passes")
}

model GateLog {
  id        String   @id @default(uuid())
  passId    String
  siteId    String
  guardId   String?
  type      String   // ENTRY, EXIT
  timestamp DateTime @default(now())
  notes     String?

  pass      VisitorPass @relation(fields: [passId], references: [id], onDelete: Cascade)
  site      Site        @relation(fields: [siteId], references: [id])

  @@map("gate_logs")
}
