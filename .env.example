# -----------------------------------------------------------------------------
# GateFlow Environment Configuration
# -----------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://gateflow:gateflow@localhost:5432/gateflow
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=gateflow-super-secret-development-jwt-key-32chars!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
OIDC_ISSUER_URL=

# Stellar & Soroban
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
CORE_CONTRACT_ID=
ATTENDANCE_CONTRACT_ID=
VISITORS_CONTRACT_ID=

# Dev Service Secrets (Use KMS in production)
SPONSOR_SECRET=
ANCHORER_SECRET=
KMS_KEY_ID=

# Security & Encryption (AES-256-GCM 32-byte hex key in dev)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
QR_SIGNING_PRIVATE_KEY=
QR_TOKEN_TTL_SECONDS=30

# Anchoring
ANCHOR_CRON="0 * * * *"
ANCHOR_PERIOD=daily
ANCHOR_MAX_RETRIES=5

# Notifications (Optional)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
SMS_PROVIDER=twilio
SMS_API_KEY=
